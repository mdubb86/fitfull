{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "fitfull tokens",
    "description": "Array of text tokens for fitfull's tokens input mode.",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "text": { "type": "string" },
            "font": { "type": "string", "description": "Font family name (e.g. 'Inter')" },
            "weight": {
                "type": "string",
                "enum": ["regular", "bold", "italic", "bolditalic"]
            },
            "size": {
                "type": "number",
                "minimum": 0.1,
                "maximum": 10,
                "description": "Relative size multiplier (1 = base, 2 = double-size emphasis, etc.)"
            }
        },
        "required": ["text", "font", "weight"],
        "additionalProperties": false
    }
}
