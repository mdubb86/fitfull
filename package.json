{
    "name": "fitfull",
    "version": "1.6.3",
    "description": "Text fitting with fontkit - supports styled tokens with varying sizes and weights",
    "type": "module",
    "packageManager": "pnpm@11.0.9",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "bin": {
        "fitfull": "./dist/cli.js"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./browser": {
            "types": "./dist/browser.d.ts",
            "import": "./dist/browser.js"
        }
    },
    "engines": {
        "node": ">=20"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "license": "MIT",
    "author": "Michael Waage <mtwaage@gmail.com>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mdubb86/fitfull.git"
    },
    "homepage": "https://github.com/mdubb86/fitfull",
    "bugs": {
        "url": "https://github.com/mdubb86/fitfull/issues"
    },
    "keywords": [
        "text-fitting",
        "svg",
        "png",
        "opentype",
        "typography",
        "layout"
    ],
    "scripts": {
        "build": "tsc",
        "build:bin": "tsc && bun build --compile src/cli.ts --outfile fitfull",
        "test": "tsc -p tsconfig.test.json && node --test \"dist-test/**/*.test.js\"",
        "test:update": "UPDATE_SNAPSHOTS=1 pnpm test",
        "test:e2e": "esbuild dist/browser.js --bundle --format=esm --platform=browser --outfile=tests/e2e/fixture-bundle.js && playwright test",
        "release:npm": "pnpm build && pnpm publish --access public",
        "release:github": "node scripts/tag-release.js"
    },
    "dependencies": {
        "@resvg/resvg-wasm": "^2.6.2",
        "commander": "^14.0.3",
        "fontkit": "^2.0.4",
        "fuzzysort": "^3.1.0",
        "get-system-fonts": "^2.0.2",
        "linkedom": "^0.18.12",
        "p-map": "^7.0.4",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@playwright/test": "^1.60.0",
        "@types/fontkit": "^2.0.9",
        "@types/node": "^24.12.3",
        "esbuild": "^0.28.0",
        "http-server": "^14.1.1",
        "typescript": "^6.0.3"
    }
}
